# =============================================================================
# .env.example — copy to .env and fill in
# =============================================================================
#
# With `docker compose up`, these env vars are read by both the db service
# (POSTGRES_*) and the app service (everything else). The compose file
# builds the DATABASE_URL automatically from POSTGRES_USER + POSTGRES_PASSWORD.
#
# If you run the app outside Docker, set DATABASE_URL yourself to point at
# your local Postgres.

# ---- Postgres (used by the db service) ----
POSTGRES_USER=decel
POSTGRES_PASSWORD=decel
POSTGRES_DB=decel
POSTGRES_PORT=5432

# ---- App (used by the api-server container) ----
# DATABASE_URL is auto-built by docker-compose; uncomment if running outside Docker.
# DATABASE_URL=postgres://decel:decel@localhost:5432/decel

EXA_API_KEY=
OPENAI_API_KEY=

# Auth (v1 = single user). Set BOTH or set DISABLE_AUTH=true for dev.
AUTH_USER=cassin
AUTH_PASS=change-me-in-prod
# DISABLE_AUTH=true   # uncomment in dev to skip the basic-auth gate

# monday.com sync (People board push)
MONDAY_API_TOKEN=
MONDAY_BOARD_PEOPLE_ID=

# LinkedIn enrichment (Proxycurl — see §12.5.5 + docs/DECISIONS.md)
PROXYCURL_API_KEY=

# Optional
# PORT=5000
# BASE_PATH=/
# FRONTEND_DIST=        # override where the api-server finds the built frontend
# HOST_PORT=8080        # host port mapped to the api-server's 5000
# SNAPSHOTS_DIR=data/snapshots
# NODE_ENV=production
