# =============================================================================
# .env.production.example — copy to .env on the Hetzner host and fill in
# =============================================================================
#
# Generate AUTH_PASS_HASH before deploying:
#   pnpm --filter @workspace/api-server run hash-password "your-real-password"
# Then paste the hash below.

# ---- Postgres (docker-compose service) ----
POSTGRES_USER=decel
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
POSTGRES_DB=decel
POSTGRES_PORT=5432

# ---- App ----
DATABASE_URL=postgres://decel:REPLACE_ME_WITH_A_LONG_RANDOM_STRING@db:5432/decel

# Real auth — required in production
AUTH_USER=cassin
# AUTH_PASS_HASH is loaded from a Docker secret file at
# /run/secrets/auth_pass_hash (mounted from ./secrets/auth_pass_hash on the
# host). Do NOT set AUTH_PASS_HASH in .env — docker compose's env_file
# parser corrupts the scrypt hash via its `$VAR` expansion pass.
#
# Provision the file before `docker compose up`:
#   mkdir -p secrets
#   pnpm --filter @workspace/api-server run hash-password "your-real-password" \
#     | tr -d '\n' > secrets/auth_pass_hash
#   chmod 600 secrets/auth_pass_hash
#
# Local dev (no secret file mounted) can fall back to setting
# AUTH_PASS_HASH here directly — the secrets loader only reads the file
# when it exists.
# AUTH_PASS=plain-only-for-dev  # do NOT set in production

# Real integrations (paste the real keys)
EXA_API_KEY=...
OPENAI_API_KEY=...
MONDAY_API_TOKEN=...
MONDAY_BOARD_PEOPLE_ID=18426688283    # "DECEL — Relationer & Dialoger"
# Column IDs are hard-coded as defaults; override per-board here if the
# monday.com board is ever recreated (the IDs change). Drop the override
# to use the built-in defaults. See artifacts/api-server/src/routes/v1/monday-sync.ts
# MONDAY_BOARD_PEOPLE_COL_NAME=name
# MONDAY_BOARD_PEOPLE_COL_ORGANISATION=text_mm68tqgj
# MONDAY_BOARD_PEOPLE_COL_ROLL=text_mm686q5p
# MONDAY_BOARD_PEOPLE_COL_EMAIL=email_mm68d54h
# MONDAY_BOARD_PEOPLE_COL_TELEFON=text_mm68y7jy
# MONDAY_BOARD_PEOPLE_COL_PRIO=color_mm68rq6f
# MONDAY_BOARD_PEOPLE_COL_DIALOGLAGE=color_mm68q8ys
# MONDAY_BOARD_PEOPLE_COL_KANALTYP=color_mm68qsm6
# MONDAY_BOARD_PEOPLE_COL_MARKNAD=color_mm68ay8
# MONDAY_BOARD_PEOPLE_COL_FORSTA_KONTAKT=date_mm68qbk
# MONDAY_BOARD_PEOPLE_COL_SENASTE_KONTAKT=date_mm686v4j
# MONDAY_BOARD_PEOPLE_COL_DEADLINE=date_mm68yeqh
# MONDAY_BOARD_PEOPLE_COL_VARFOR_PRATAR=long_text_mm68ht6q
# MONDAY_BOARD_PEOPLE_COL_VAR_IGEN=long_text_mm68ekzg
# MONDAY_BOARD_PEOPLE_COL_NASTA_STEG=text_mm68p80x
# MONDAY_BOARD_PEOPLE_COL_KALLA=text_mm68c05h
PROXYCURL_API_KEY=...

# Optional
PORT=5000
NODE_ENV=production
HOST_PORT=443                       # if behind Caddy
TZ=Europe/Stockholm                 # §12.5 GDPR — keep timestamps sane

# Demo mode — leave unset in production. The store-factory switches to the
# real Drizzle/Postgres backend automatically when DATABASE_URL is reachable.
# DEMO_MODE=true
