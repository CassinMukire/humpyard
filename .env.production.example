# =============================================================================
# .env.production.example — copy to .env on the Hetzner host and fill in
# =============================================================================
#
# Generate AUTH_PASS_HASH before deploying:
#   pnpm --filter @workspace/api-server run hash-password "your-real-password"
# Then paste the hash below.

# ---- Postgres (docker-compose service) ----
POSTGRES_USER=decel
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
POSTGRES_DB=decel
POSTGRES_PORT=5432

# ---- App ----
DATABASE_URL=postgres://decel:REPLACE_ME_WITH_A_LONG_RANDOM_STRING@db:5432/decel

# Real auth — required in production
AUTH_USER=cassin
AUTH_PASS_HASH=scrypt$16384$8$1$...$...   # generate with hash-password
# AUTH_PASS=plain-only-for-dev  # do NOT set in production

# Real integrations (paste the real keys)
EXA_API_KEY=...
OPENAI_API_KEY=...
MONDAY_API_TOKEN=...
MONDAY_BOARD_PEOPLE_ID=18426688283    # "DECEL — Relationer & Dialoger"
PROXYCURL_API_KEY=...

# Optional
PORT=5000
NODE_ENV=production
HOST_PORT=443                       # if behind Caddy
TZ=Europe/Stockholm                 # §12.5 GDPR — keep timestamps sane

# Demo mode — leave unset in production. The store-factory switches to the
# real Drizzle/Postgres backend automatically when DATABASE_URL is reachable.
# DEMO_MODE=true
